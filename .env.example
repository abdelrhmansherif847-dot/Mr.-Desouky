# ---------------------------------------------------------------------------
# Contact form delivery — OPTIONAL
#
# The site is deployed as a static export (GitHub Pages), so there is no server
# to receive a POST. The form submits from the browser to whatever endpoint you
# set here — Formspree, Web3Forms, Getform, Basin, or your own function.
#
# NEXT_PUBLIC_ is required: the value ships in the browser bundle. That is why
# these services issue per-form endpoint URLs rather than secret API keys.
#
# On GitHub, add this under
#   Settings → Secrets and variables → Actions → Variables
# (a variable, not a secret — the workflow reads it as `vars.`).
#
# Leave it unset and the form still validates, keeps everything typed, and
# hands the completed enquiry to WhatsApp with every field filled in. It never
# claims a message was delivered when it was not.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx


# ---------------------------------------------------------------------------
# Deployment — normally set automatically by .github/workflows/deploy-pages.yml.
# Only set these by hand to reproduce a deployed build locally.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_BASE_PATH=/Mr.-Desouky
# NEXT_PUBLIC_SITE_URL=https://abdelrhmansherif847-dot.github.io/Mr.-Desouky


# ---------------------------------------------------------------------------
# Owner / admin account — NOT USED YET
#
# No NEXT_PUBLIC_ prefix, deliberately: Next.js only inlines NEXT_PUBLIC_
# variables into the browser bundle, so this address cannot reach client
# JavaScript even by accident. Never commit a real value.
#
# It does nothing until the site runs on a host with a server and a real auth
# provider -- on static GitHub Pages there is nothing to enforce a check.
# See docs/ADMIN.md and src/lib/admin/auth.ts.
# ---------------------------------------------------------------------------

# ADMIN_EMAIL=you@example.com
