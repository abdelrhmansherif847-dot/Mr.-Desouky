# ---------------------------------------------------------------------------
# Contact form delivery — OPTIONAL
#
# With none of these set, the contact form still validates and responds: it
# tells the visitor it could not send and points them at WhatsApp and email.
# It never silently drops an enquiry or falsely reports success.
#
# Set all four to turn delivery on. See src/lib/contact/deliver.ts to swap
# Resend for SMTP, a CRM, or a database write.
# ---------------------------------------------------------------------------

CONTACT_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=info@desoukymath.com
CONTACT_FROM=site@yourdomain.com
