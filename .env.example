# ---------------------------------------------------------------------------
# Contact form delivery — OPTIONAL
#
# The site is deployed as a static export (GitHub Pages), so there is no server
# to receive a POST. The form submits from the browser to whatever endpoint you
# set here — Formspree, Web3Forms, Getform, Basin, or your own function.
#
# NEXT_PUBLIC_ is required: the value ships in the browser bundle. That is why
# these services issue per-form endpoint URLs rather than secret API keys.
#
# On GitHub, add this under
#   Settings → Secrets and variables → Actions → Variables
# (a variable, not a secret — the workflow reads it as `vars.`).
#
# Leave it unset and the form still validates, keeps everything typed, and
# hands the completed enquiry to WhatsApp with every field filled in. It never
# claims a message was delivered when it was not.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx


# ---------------------------------------------------------------------------
# Deployment — normally set automatically by .github/workflows/deploy-pages.yml.
# Only set these by hand to reproduce a deployed build locally.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_BASE_PATH=/Mr.-Desouky
# NEXT_PUBLIC_SITE_URL=https://abdelrhmansherif847-dot.github.io/Mr.-Desouky


# ---------------------------------------------------------------------------
# Authentication and the admin area — Supabase
#
# Required for the authenticated deployment (Vercel). Leave unset and the
# guard refuses every /admin request rather than failing open, and the public
# static build ignores these entirely.
#
# Both values are public by design: they identify the project and are meant to
# ship in the browser. They grant nothing on their own — row-level security
# decides what any request may read, from the caller's verified session.
#
# Find them in Supabase → Project Settings → API.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key>

# NEVER put the service_role key in this file, in the repository, or in any
# NEXT_PUBLIC_ variable. It bypasses row-level security completely.


# ---------------------------------------------------------------------------
# Build mode
#
# STATIC_EXPORT=true produces the flat public marketing site for GitHub Pages.
# Unset, the build is a normal Next.js server build for Vercel, where the
# /admin guard in middleware.ts actually runs.
# ---------------------------------------------------------------------------

# STATIC_EXPORT=true


# ---------------------------------------------------------------------------
# CAPTCHA — Cloudflare Turnstile, verified by Supabase Auth
#
# The SITE key is public by design (it draws the widget in the browser). Set
# it in Vercel → Project → Settings → Environment Variables, not in this file.
# With it unset, the sign-up form refuses to submit, and sign-in / reset work
# exactly as before.
#
# The SECRET key goes ONLY into Supabase → Authentication → Bot and Abuse
# Protection → Enable CAPTCHA protection (provider: Turnstile). It must never
# appear here, in the repository, in Vercel, or in any NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<Turnstile site key>
